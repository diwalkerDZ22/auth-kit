# ============ Application (example/main.py) : infrastructure du projet ============
DATABASE_URL=sqlite:///./auth.db
# PostgreSQL : sslmode imposé (require par défaut). "disable" pour un Postgres local sans SSL.
# DATABASE_SSLMODE=require
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
# console : les mails sont écrits dans les logs (DEV UNIQUEMENT) ; resend : envoi réel
EMAIL_BACKEND=resend
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
MAIL_FROM_NAME=auth-kit
# Rate-limit partagé entre workers / serveurs : redis://localhost:6379
RATE_LIMIT_STORAGE_URI=memory://
# Refuse les mots de passe déjà fuités (API Have I Been Pwned, k-anonymity)
PASSWORD_BREACH_CHECK=true

# ============ auth-kit (AuthSettings, préfixe AUTH_) ============
# Au moins 32 caractères : python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=
AUTH_APP_NAME=auth-kit
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_REFRESH_REUSE_GRACE_SECONDS=30
AUTH_SIGNUP_TOKEN_EXPIRE_HOURS=24
AUTH_LOGIN_TOKEN_EXPIRE_MINUTES=15
AUTH_RESET_TOKEN_EXPIRE_MINUTES=30
# false : connexion sans lien email (DEV UNIQUEMENT, pour Swagger)
AUTH_LOGIN_EMAIL_REQUIRED=true
AUTH_LOGIN_FAILURES_PER_ACCOUNT=10/15minutes
# Limites par IP à surcharger, ex. {"login": "20/15minutes"}
# AUTH_RATE_LIMITS={}
AUTH_FRONTEND_VERIFY_URL=http://localhost:5173/verify-email
AUTH_FRONTEND_RESET_URL=http://localhost:5173/reset-password
# Page HTML GET /auth/verify pour tester les liens sans frontend (DEV UNIQUEMENT)
AUTH_VERIFY_TEST_PAGE=false
# false seulement en dev HTTP
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=strict
