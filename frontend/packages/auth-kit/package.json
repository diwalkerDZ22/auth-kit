{
  "name": "@auth-kit/react",
  "version": "0.8.0",
  "description": "Client, hooks React et pages prêtes à l'emploi pour le backend auth-kit.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./client": "./src/client/index.ts",
    "./react": "./src/react/index.ts",
    "./ui": "./src/ui/index.ts",
    "./ui/styles.css": "./src/ui/styles.css"
  },
  "files": [
    "src",
    "openapi.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "gen:api": "npx --yes -p typescript@5.9.3 -p openapi-typescript@7.13.0 openapi-typescript openapi.json -o src/client/api.gen.ts"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^7",
    "@tanstack/react-query": "^5",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7",
    "react-router": "^8",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "@hookform/resolvers": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  }
}
